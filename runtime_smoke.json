{
  "mode": "service",
  "start": "CGO_ENABLED=0 go build -o ./bin/engine ./cmd/engine && ./bin/engine -config configs/config.yaml",
  "workdir": ".",
  "env": {
    "HTTP_ADDR": ":18080",
    "GRPC_ADDR": ":19090",
    "POSTGRES_DSN": "postgres://workflow:workflow@localhost:5432/workflow?sslmode=disable",
    "REDIS_ADDR": "localhost:6379",
    "AUTH_BOOTSTRAP_TOKEN": "dev-secret-token"
    ,"CGO_ENABLED": "0"
  },
  "ready_url": "http://127.0.0.1:18080/healthz",
  "ready_status": [200],
  "startup_timeout": 20
}
